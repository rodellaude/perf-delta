# ==============================================================================
# Perf-Delta .gitignore (UTF-8)
# ==============================================================================

# Secrets & Credentials (NEVER commit)
secrets.yaml
.env
.env.*

# Node.js Dependencies & Build Outputs
node_modules/
dashboard-api/node_modules/
dashboard-ui/node_modules/
dashboard-ui/dist/
dist-offline/
*.tsbuildinfo

# Runtime Data, Vaults, Raw CSVs & Generated Reports
Data/*.db
Data/*.db.wal
Data/*.db.tmp
Data/*.duckdb
Data/*.duckdb.wal
RawResults/
Reports/
Evidence/
*.tmp

# OS & Editor Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/*.log
.positai
